<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:clipToOutline="true"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true">

    <!-- Left Section: Flame or Sparkles Icon -->
    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_fire"
        android:contentDescription="Streak status icon" />

    <!-- Main Content: Streak info and Action button -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="start|center_vertical">

        <!-- Dynamic Streak Count -->
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5 Day Streak"
            android:textColor="@color/navy_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Motivational Message -->
        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Keep it alive today ✨"
            android:textColor="@color/muted_blue_grey"
            android:textSize="12sp" />

        <!-- Action / CTA Button (Styled as a pill) -->
        <TextView
            android:id="@+id/widget_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill_button"
            android:text="Open Word Me! →"
            android:textColor="@color/accent_blue"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:singleLine="true" />

    </LinearLayout>

</LinearLayout>
